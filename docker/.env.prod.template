# Copiar a .env.prod y completar. NUNCA subir .env.prod a git.

POSTGRES_USER=medusa
POSTGRES_PASSWORD=CAMBIAR_password_larga_y_aleatoria
POSTGRES_DB=angiecatalogos

# Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIAR
COOKIE_SECRET=CAMBIAR

# Dominios reales (ejemplo: tienda en angiecatalogos.com, API en api.angiecatalogos.com)
STORE_CORS=https://tienda.cescjavier.dev
ADMIN_CORS=https://tienda-api.cescjavier.dev
AUTH_CORS=https://tienda.cescjavier.dev,https://tienda-api.cescjavier.dev
BACKEND_PUBLIC_URL=https://tienda-api.cescjavier.dev

# Se obtiene tras el primer arranque: panel admin → Settings → Publishable API Keys
MEDUSA_PUBLISHABLE_KEY=pk_CAMBIAR

# Google login (opcional)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_CALLBACK_URL=https://tienda.cescjavier.dev/cuenta/callback
#NUXT_PUBLIC_GOOGLE_AUTH=true

# Google Sheets sync (opcional): subir google-sa.json junto a este archivo
#GOOGLE_SA_KEY_FILE=/app/google-sa.json
#GOOGLE_SHEET_ID=

# Pasarela PayPhone. El token es secreto: sale de PayPhone Developer →
# Credenciales, y el ambiente (pruebas/producción) se elige en su panel.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
