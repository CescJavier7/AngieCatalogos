# Copiar a .env.prod y completar. NUNCA subir .env.prod a git.

POSTGRES_USER=medusa
POSTGRES_PASSWORD=CAMBIAR_password_larga_y_aleatoria
POSTGRES_DB=angiecatalogos

# Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIAR
COOKIE_SECRET=CAMBIAR

# Dominios reales (ejemplo: tienda en angiecatalogos.com, API en api.angiecatalogos.com)
STORE_CORS=https://tienda.cescjavier.dev
ADMIN_CORS=https://tienda-api.cescjavier.dev
AUTH_CORS=https://tienda.cescjavier.dev,https://tienda-api.cescjavier.dev
BACKEND_PUBLIC_URL=https://tienda-api.cescjavier.dev

# Se obtiene tras el primer arranque: panel admin → Settings → Publishable API Keys
MEDUSA_PUBLISHABLE_KEY=pk_CAMBIAR

# Google login (opcional)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_CALLBACK_URL=https://tienda.cescjavier.dev/cuenta/callback
#NUXT_PUBLIC_GOOGLE_AUTH=true

# Google Sheets sync (opcional): subir google-sa.json junto a este archivo
#GOOGLE_SA_KEY_FILE=/app/google-sa.json
#GOOGLE_SHEET_ID=

# Pasarela PayPhone. El token es secreto: sale de PayPhone Developer →
# Credenciales, y el ambiente (pruebas/producción) se elige en su panel.
# Sin token, el checkout sigue funcionando solo con el pago coordinado.
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# Régimen tributario del comercio, para el desglose que exige PayPhone.
#   0  → sin IVA (RIMPE Negocio Popular, notas de venta)
#   15 → los precios del catálogo YA incluyen IVA y se separa la base
PAYPHONE_IVA=0

# A dónde devuelve PayPhone a la clienta después de pagar. Si se omite se usa
# el primer origen de STORE_CORS, que ya apunta a la tienda.
STOREFRONT_URL=https://tienda.cescjavier.dev

# Píxel de Meta (publicidad en Facebook e Instagram). Se saca del
# Administrador de eventos → Orígenes de datos. Vacío = sin seguimiento y sin
# una sola petición a Facebook desde la tienda.
META_PIXEL_ID=

# Correo saliente (comprobantes de compra). Sin estas dos, el comprobante se
# escribe en el log del backend en vez de enviarse: sirve para revisar el
# diseño sin contratar nada.
# El remitente TIENE que estar verificado en SendGrid → Sender Authentication,
# si no rechazan el envío.
SENDGRID_API_KEY=
SENDGRID_FROM=hola@cescjavier.dev

# Correo de la tienda: ahí llega el aviso de CADA pedido nuevo, cobrado o no,
# con qué empacar y a dónde enviarlo. Puede ser el Gmail de siempre.
TIENDA_EMAIL=
